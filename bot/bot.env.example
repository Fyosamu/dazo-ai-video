# ===========================================================================
# پیکربندی ربات تلگرام MoneyPrinterTurbo
# این فایل را کنار bot.py با نام bot.env ذخیره کنید.
# متغیرهای محیطی (Docker) مقدارهای اینجا را بازنویسی می‌کنند.
# ===========================================================================

# --- تلگرام (الزامی برای اجرای ربات) -------------------------------------
# از @BotFather با دستور /newbot بگیرید
TELEGRAM_BOT_TOKEN=

# محدودسازی به چت‌های مشخص (خالی = همه؛ شناسه عددی را از getUpdates ببینید)
# مثال: ALLOWED_CHAT_IDS=123456789
ALLOWED_CHAT_IDS=

# اگر تلگرام فیلتر است، پروکسی HTTP محلی بدهید (فقط سیستم میزبان/ویندوز)
# مثال: http://127.0.0.1:10809
HTTPS_PROXY=

# --- سرویس MoneyPrinterTurbo ----------------------------------------------
# روی همین سیستم: 127.0.0.1:8080 | در داکر: http://moneyprinterturbo-api:8080
MPT_API_BASE=http://127.0.0.1:8080
# فقط اگر app.api_key در config.toml سرور ست شده باشد
MPT_API_KEY=

# --- محتوای ویدیو (انگلیسی) ------------------------------------------------
# منبع ویدیو: pexels | pixabay | local (local فقط برای تست با فایل محلی)
VIDEO_SOURCE=pexels
# 9:16 عمودی (شورتس/ریلز/تیکتاک)، 16:9 افقی
VIDEO_ASPECT=9:16
# گوینده انگلیسی Edge TTS
VIDEO_VOICE=en-US-AriaNeural-Female
VIDEO_LANGUAGE=English
VIDEO_CLIP_DURATION=5
VIDEO_COUNT=1
BGM_VOLUME=0.2
SUBTITLE_ENABLED=true

# --- زمان‌بندی -------------------------------------------------------------
POLL_SECONDS=10
EDIT_SECONDS=45
# حداکثر زمان انتظار ساخت یک ویدیو (ثانیه)
MAX_WAIT_SECONDS=1800
